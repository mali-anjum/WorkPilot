# Placeholder / example values only. Copy to .env and replace every value
# before running `docker compose up`. Never commit a real .env file.
#
# The .NET backend's EF Core connection string (see src/WorkPilot.Api's
# appsettings and the AppHost) must point at the SAME db/POSTGRES_PASSWORD
# combination configured here, so both sides share one Postgres database
# per docs/specs/0001-stack-architecture.md.

# --- Postgres (shared database: EF Core + Supabase both connect here) ---
POSTGRES_PASSWORD=example-postgres-password-change-me
POSTGRES_DB=postgres
# 5433, not 5432: this machine already runs a local system Postgres on 5432
POSTGRES_PORT=5433

# --- GoTrue (Supabase Auth) ---
JWT_SECRET=example-jwt-secret-at-least-32-characters-long-change-me
JWT_EXPIRY=3600
GOTRUE_PORT=9999
SITE_URL=http://localhost:5128
ADDITIONAL_REDIRECT_URLS=
# No public signup anywhere in the app (docs/specs/0004-auth-app-shell.md,
# AC-8): the one founder account is created directly against GoTrue.
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
# The path GoTrue's password recovery email link points at, under SITE_URL,
# matching WorkPilot.Web's GET /reset-password?token_hash=... route.
MAILER_URLPATHS_RECOVERY=/reset-password
PASSWORD_MIN_LENGTH=8
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Storage ---
STORAGE_PORT=5001
ANON_KEY=example-anon-key-replace-with-generated-supabase-jwt
SERVICE_ROLE_KEY=example-service-role-key-replace-with-generated-supabase-jwt

# --- Public URL Supabase reports back to clients (only relevant once a
#     gateway such as Kong is added; deferred in this minimal stack) ---
SUPABASE_PUBLIC_URL=http://localhost:8000

# --- AI providers (spec 0006) ---
# Not read by this compose stack: the Api reads them. Keys never go in a
# tracked file. In dev prefer `dotnet user-secrets set "Ai:Providers:<name>:ApiKey" <key>
# --project src/WorkPilot.Api`; in prod set these env vars on the Api.
# Ai__Providers__openai__ApiKey=
# Ai__Providers__gemini__ApiKey=
# Ai__Providers__deepseek__ApiKey=
# Pick a provider and model per purpose (Default is the fallback):
# Ai__Purposes__Default__Provider=gemini
# Ai__Purposes__Default__Model=gemini-3.8-flash
