#!/bin/sh
# Format only pre-commit gate (see AGENTS.md ## Rules): runs `dotnet format`
# against staged .cs files and re-stages anything it rewrites. Does not run
# lint or typecheck; that's a deliberate choice to keep commits fast.
#
# One time setup (per clone): git config core.hooksPath .githooks

set -e

staged_cs_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.cs')

if [ -z "$staged_cs_files" ]; then
  exit 0
fi

echo "$staged_cs_files" | xargs dotnet format WorkPilot.slnx --include

echo "$staged_cs_files" | xargs git add
