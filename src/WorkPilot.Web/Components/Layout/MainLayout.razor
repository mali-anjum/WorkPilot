@inherits LayoutComponentBase

<AppShell InitialTheme="@InitialTheme">
    @Body
</AppShell>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // The whole routed tree is InteractiveServer (set once on <Routes> in App.razor), so
    // MainLayout can't read HttpContext directly here (only a truly static component can).
    // App.razor reads the theme cookie once and forwards it down as a named cascading
    // value instead, which (unlike a RenderFragment) is a plain string and can cross the
    // static-to-interactive render mode boundary safely.
    [CascadingParameter(Name = "InitialTheme")]
    private string InitialTheme { get; set; } = "dark";
}
