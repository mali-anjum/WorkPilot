@page "/jobs"
@using WorkPilot.Application.Modules.Jobs.Matching
@using WorkPilot.Web.Features.Jobs
@using WorkPilot.Web.Features.Profile
@inject IJobsApiClient JobsApi

<HeadContent><link rel="stylesheet" href="css/matching.css" /></HeadContent>
<PageTitle>Jobs</PageTitle>

<PageHeader Title="Jobs" Description="Every discovered job, best match for your profile first." />

@if (_error is not null)
{
    <p class="wp-match__error" role="alert">@_error</p>
}

@if (_list is { ProfileIncomplete: true })
{
    <p class="wp-match__banner" role="status">
        Your profile has no skills or no experience yet, so scores are thin.
        <a href="/profile">Complete your profile</a> to get real matches.
    </p>
}

@if (_list is null && _error is null)
{
    <p class="wp-match__muted">Loading…</p>
}
else if (_list is { Total: 0 })
{
    <EmptyState Title="No jobs yet" Description="Jobs appear here once a job source is ingested; each is scored against your profile." Icon="💼" />
}
else if (_list is not null)
{
    <ul class="wp-match__list">
        @foreach (var item in _list.Items)
        {
            <li class="wp-match__row">
                <span class="wp-match__score">
                    <Badge Status="@ScoreStatus(item)">@(item.Score?.ToString() ?? "–")</Badge>
                </span>
                <span class="wp-match__job">
                    <a class="wp-match__title" href="@($"/jobs/{item.JobId}")">@item.Title</a>
                    <span class="wp-match__muted">@item.Company@(item.Location is null ? "" : $" · {item.Location}")</span>
                </span>
                <span class="wp-match__tags">
                    @if (item.HasBlocker)
                    {
                        <Badge Status="StatusKind.Danger">Blocker</Badge>
                    }
                    @if (item.Confidence is not null)
                    {
                        <Badge Status="StatusKind.Neutral">@item.Confidence confidence</Badge>
                    }
                    else
                    {
                        <span class="wp-match__muted">Not scored yet</span>
                    }
                </span>
            </li>
        }
    </ul>

    <nav class="wp-match__pager" aria-label="Pages">
        <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" Disabled="@(_page <= 1 || _busy)" OnClick="() => GoToAsync(_page - 1)">Previous</Button>
        <span class="wp-match__muted">Page @_page of @PageCount · @_list.Total jobs</span>
        <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" Disabled="@(_page >= PageCount || _busy)" OnClick="() => GoToAsync(_page + 1)">Next</Button>
    </nav>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private MatchListDto? _list;
    private Guid _profileId;
    private int _page = 1;
    private string? _error;
    private bool _busy;

    private int PageCount => _list is null ? 1 : Math.Max(1, (int)Math.Ceiling(_list.Total / (double)_list.PageSize));

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null || ProfileWebExtensions.ProfileId((await AuthState).User) is not { } profileId)
        {
            _error = "Your session has no profile; sign in again.";
            return;
        }

        _profileId = profileId;
        await GoToAsync(1);
    }

    private async Task GoToAsync(int page)
    {
        _busy = true;
        try
        {
            var result = await JobsApi.ListMatchesAsync(_profileId, page);
            if (result.Succeeded)
            {
                _list = result.Value;
                _page = page;
                _error = null;
            }
            else
            {
                _error = result.Error;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    // Unscored and blocked jobs are neutral and danger; otherwise the score band.
    private static StatusKind ScoreStatus(MatchListItemDto item) => item switch
    {
        { Score: null } => StatusKind.Neutral,
        { HasBlocker: true } => StatusKind.Danger,
        { Score: >= 70 } => StatusKind.Success,
        { Score: >= 40 } => StatusKind.Warning,
        _ => StatusKind.Danger,
    };
}
