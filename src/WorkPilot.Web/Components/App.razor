<!DOCTYPE html>
<html lang="en" data-theme="@Theme">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["css/tokens.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["WorkPilot.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <CascadingValue Value="Theme" Name="InitialTheme">
        <Routes @rendermode="InteractiveAuto" />
    </CascadingValue>
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // Read before first paint (App.razor's HttpContext cascading parameter, available
    // during the server render), so data-theme is correct on the very first byte with
    // no dark-mode flash and no dependency on JS interop having run yet.
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string Theme =>
        HttpContext?.Request.Cookies["workpilot-theme"] == "light" ? "light" : "dark";
}
