<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkPilot.Web.Client\WorkPilot.Web.Client.csproj" />
    <ProjectReference Include="..\WorkPilot.Contracts\WorkPilot.Contracts.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkPilot.ServiceDefaults\WorkPilot.ServiceDefaults.csproj" />
    <!-- Only for IAuthService/Client (GoTrue calls); the Web host never touches
         WorkPilotDbContext directly, that stays owned by WorkPilot.Api (see
         docs/specs/0004-auth-app-shell.md). -->
    <ProjectReference Include="..\WorkPilot.Application\WorkPilot.Application.csproj" />
    <ProjectReference Include="..\WorkPilot.Infrastructure\WorkPilot.Infrastructure.csproj" />
  </ItemGroup>

</Project>
